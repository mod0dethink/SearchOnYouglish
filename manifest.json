{
  "manifest_version": 3,
  "name": "Search on Youglish",
  "version": "1.1",
  "description": "選択したテキストを右クリックで YouGlish に送り、英語の発音を動画で確認できます。",
  "permissions": ["contextMenus"],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  }
}
